# =============================================================================
# URBANS.COS - WhatsApp Automation - Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env real a un repositorio.
# =============================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://tu-dominio.com

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbans_whatsapp?schema=public

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=usa-un-token-aleatorio-de-al-menos-32-caracteres
META_APP_SECRET=

# --- Numero/s internos de notificacion ---
ADVISOR_NOTIFICATION_NUMBER=

# --- Seguridad API interna ---
INTERNAL_API_KEY=usa-otro-token-aleatorio-de-al-menos-32-caracteres

# --- CRM externo opcional ---
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# --- Seguimiento / Abandono ---
ABANDONMENT_REMINDER_HOURS=6
ABANDONMENT_CLOSE_HOURS=48
ABANDONMENT_CRON_INTERVAL_MINUTES=30

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=1200

# --- Logging ---
LOG_LEVEL=info

# --- Seguridad / Privacidad ---
# Vacío = rechaza solicitudes CORS de navegadores; llamadas server-to-server sin Origin siguen permitidas.
ALLOWED_ORIGINS=
STORE_MESSAGE_CONTENT=false
MESSAGE_RETENTION_DAYS=30
PROCESSED_MESSAGE_RETENTION_DAYS=7
